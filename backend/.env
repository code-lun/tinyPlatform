# ============================================================
# 环境变量配置模板
# 复制为 .env 文件并根据实际情况修改
# ============================================================

# 脚本存放目录（相对于 backend 目录）
SCRIPTS_DIR=../scripts

# 脚本执行超时时间（秒）
SCRIPT_TIMEOUT=30

# 服务端口
PORT=8000

# 日志级别
LOG_LEVEL=info

# 允许的前端域名（CORS）
ALLOWED_ORIGINS=*


# ===== GitHub =====
GITHUB_CLIENT_ID=你的_GitHub_Client_ID
GITHUB_CLIENT_SECRET=你的_GitHub_Client_Secret

# ===== Gitee =====
GITEE_CLIENT_ID=a47ca548e3b7d25f565d97f1aa3dbdde778a44a7ab555bef4d0613d30e1bb228
GITEE_CLIENT_SECRET=85f3c047c52c04b9d689e30d36085b9d3c54069734064bf87e8e7bdf772a0b19

# ===== 自建 GitLab =====
GITLAB_CLIENT_ID=你的_GitLab_Application_ID
GITLAB_CLIENT_SECRET=你的_GitLab_Secret
GITLAB_URL=https://你的gitlab域名  # 不带末尾斜杠，如 https://gitlab.company.com

# ===== 通用配置 =====
REDIRECT_URI=http://你的后端IP:8000/auth/callback  # 必须与平台填写的完全一致