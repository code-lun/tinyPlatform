# ============================================================
# 环境变量配置模板
# 复制为 .env 文件并根据实际情况修改
# ============================================================

# 脚本存放目录（相对于 backend 目录）
SCRIPTS_DIR=../scripts

# 脚本执行超时时间（秒）
SCRIPT_TIMEOUT=30

# 服务端口
PORT=8000

# 日志级别: debug | info | warning | error
LOG_LEVEL=info
# 日志写文件开关 true为开启
LOG_FILE_ENABLED=false

# 允许的前端域名（CORS）
ALLOWED_ORIGINS=*

# API Token（所有 /api/* 请求必须携带 Authorization: Bearer <token>）
API_TOKEN=tinyPlatform-token-2024

